{
  "id": "sample-config",
  "name": "sample-config",
  "description": "Phase 2 — UCB parent pick over the derived dictionary (PLAN.md §2.7 / IMPLEMENTATION.md §2.7). Runs inline as a `command`; called by orchestrator. SCAN reads every dict/configs/*/score.json into a table (scripts/derive_dictionary.py --json); PICK chooses argmax(aggregate + c*stderr), treating unscored bundles as +inf (must-explore). Deterministic (scripts/ucb_pick.py) rather than an LLM prompt — UCB is closed-form, so a prompt would only add cost/variance. Returns parent_id. Samples the whole dictionary: one uniform population, no target/optimizer split.",
  "arguments": [],
  "flowchart": {
    "start_block_id": "start",
    "blocks": {
      "start": { "id": "start", "type": "start", "name": "START" },
      "scan": {
        "id": "scan",
        "type": "bash",
        "name": "SCAN",
        "command": "set -eu\nPY=/home/acer01/axi-assistant/.venv/bin/python\nREAL=/home/acer01/axi-assistant/user-data/autoresearch\nAR=\"${AUTORES_ROOT:-$REAL}\"\n\"$PY\" \"$REAL/derive_dictionary.py\" --json --dict-dir \"$AR/dict/configs\"",
        "working_directory": "",
        "output_variable": "dict_table",
        "continue_on_error": false
      },
      "pick": {
        "id": "pick",
        "type": "bash",
        "name": "PICK_UCB",
        "command": "set -eu\nPY=/home/acer01/axi-assistant/.venv/bin/python\nSCRIPTS=/home/acer01/axi-assistant/user-data/autoresearch/dict/configs/optimizer-seed/scripts\n\"$PY\" \"$SCRIPTS/ucb_pick.py\"",
        "working_directory": "",
        "output_variable": "parent_id",
        "continue_on_error": false
      },
      "end": { "id": "end", "type": "end", "name": "END" }
    },
    "connections": [
      { "id": "c1", "source_block_id": "start", "target_block_id": "scan", "source_port": "out", "target_port": "in" },
      { "id": "c2", "source_block_id": "scan", "target_block_id": "pick", "source_port": "out", "target_port": "in" },
      { "id": "c3", "source_block_id": "pick", "target_block_id": "end", "source_port": "out", "target_port": "in" }
    ]
  },
  "metadata": { "created": "2026-08-15", "version": "1.0-phase2", "author": "hackathon-rnd", "tags": ["autoresearch", "optimizer", "phase2"] }
}
