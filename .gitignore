# INVERTED / ALLOWLIST-STYLE GITIGNORE
#
# This gitignore is inverted: everything is ignored by default, and only
# explicitly-allowlisted paths are eligible to be tracked. The goal is
# to minimize the risk of a rogue agent (or human) accidentally staging
# sensitive data, runtime state, build artifacts, or personal scratch
# files.
#
# To track a new top-level path, add a `!/name` negation below. To add
# a tracked file inside an otherwise-ignored subtree (like .claude/),
# negate each parent directory first, then the target.

# --- Ignore everything at the repo root ---
/*

# --- Allowlisted top-level directories ---
!/.github/
!/axi/
!/bin/
!/commands/
!/docs/
!/extensions/
!/packages/
!/prompts/
!/scripts/
!/tests/

# --- Allowlisted top-level files ---
!/.env.template
!/.gitignore
!/.pre-commit-config.yaml
!/LICENSE
!/README.md
!/axi-bot.service
!/axi-procmux.service
!/axi-test@.service
!/axi_test.py
!/docker-compose.yml
!/pyproject.toml
!/pyrightconfig.json
!/pytest.ini
!/ruff.toml
!/uv.lock

# --- .claude/: track commands/ and skills/, hide runtime state ---
!/.claude/
/.claude/*
!/.claude/commands/
!/.claude/skills/

# --- user-data/: track ONLY the autoresearch optimizer, never its scratch traces ---
# scratch/ holds full agent reasoning traces (reasoning_trace.jsonl, run logs)
# and stays ignored; everything else here is the optimizer's own source + its
# durable search record (results.tsv, ideas/events.jsonl).
!/user-data/
/user-data/*
!/user-data/autoresearch/
/user-data/autoresearch/scratch/
# runtime artifacts of the idea store: a zero-byte flock sidecar and a derived
# render digest. events.jsonl IS tracked — it is the durable search record.
/user-data/autoresearch/ideas/.lock
/user-data/autoresearch/ideas/.render-hash

# --- Build / cache artifacts anywhere in the tree ---
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/dist/
**/build/
**/target/

# --- Explicit exclusions inside allowlisted directories ---
/scripts/replay_minflow_ops.py
test-audit/
